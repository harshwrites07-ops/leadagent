# ─── YouTube Data API v3 ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ─── Reddit API ───────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=ContentCrafterzz/1.0 (by /u/your_reddit_username)

# ─── Google Gemini API keys (add up to 5 for key rotation) ──────────────────
# Get free keys from aistudio.google.com — free tier resets every 60 seconds
# GEMINI_API_KEY=your_key  (legacy, still works)
# GEMINI_API_KEY_1=your_key
# GEMINI_API_KEY_2=your_key
# GEMINI_API_KEY_3=your_key
# GEMINI_API_KEY_4=your_key
# GEMINI_API_KEY_5=your_key

# ─── SMTP Email Sending ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=Your Name | ContentCrafterzz

# ─── IMAP Email Reading (for reply detection) ─────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password_here

# ─── App Config ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change_this_to_a_random_secret_string

# ─── Gmail OAuth (per-user Gmail sending + Google Sign-In) ───────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URIs must include: https://yourdomain.com/api/gmail/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GMAIL_REDIRECT_URI=https://yourdomain.com/api/gmail/callback

# ─── Razorpay Payments ───────────────────────────────────────────────────────
# Get these from your Razorpay dashboard: https://dashboard.razorpay.com/app/keys
# Billing plans are configured in USD — international payments must be enabled
# on your Razorpay account to charge non-INR cards.
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
# Set this in Razorpay dashboard under Webhooks to verify webhook signatures
RAZORPAY_WEBHOOK_SECRET=

# ─── Agency Profile (used by AI for pitch generation) ─────────────────────────
AGENCY_NAME=ContentCrafterzz
YOUR_NAME=Your Name
YOUR_ROLE=Founder
PORTFOLIO_URL=https://yourportfolio.com
PRICING_RANGE=$500-$2000/month
