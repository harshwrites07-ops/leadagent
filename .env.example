# ─── YouTube Data API v3 ───────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ─── Reddit API ───────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=ContentCrafterzz/1.0 (by /u/your_reddit_username)

# ─── Anthropic / Claude API ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── SMTP Email Sending ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=Your Name | ContentCrafterzz

# ─── IMAP Email Reading (for reply detection) ─────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password_here

# ─── App Config ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=change_this_to_a_random_secret_string

# ─── Gmail OAuth (per-user Gmail sending + Google Sign-In) ───────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URIs must include: https://yourdomain.com/api/gmail/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GMAIL_REDIRECT_URI=https://yourdomain.com/api/gmail/callback

# ─── Stripe Payments ─────────────────────────────────────────────────────────
# Get these from your Stripe dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create products/prices in Stripe dashboard, then paste the price IDs below
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...
# Publishable key goes in frontend (prefix with VITE_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Agency Profile (used by AI for pitch generation) ─────────────────────────
AGENCY_NAME=ContentCrafterzz
YOUR_NAME=Your Name
YOUR_ROLE=Founder
PORTFOLIO_URL=https://yourportfolio.com
PRICING_RANGE=$500-$2000/month
